[Unit]
Description=Association 100,000 Ames (AMA) Next.js Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=bentz
WorkingDirectory=/var/www/ama.bittonik.com
ExecStart=/usr/bin/npm run start -- -p 3050
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3050
EnvironmentFile=/var/www/ama.bittonik.com/.env

# Limites de sécurité et ressources
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ama-web

[Install]
WantedBy=multi-user.target
