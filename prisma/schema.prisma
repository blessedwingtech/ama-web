// Prisma schema for Association 100,000 Âmes (AMA)
// Datasource PostgreSQL with fallback support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model PrayerRequest {
  id          String   @id @default(uuid())
  fullName    String
  email       String?
  phone       String?
  location    String?
  title       String
  description String
  isAnonymous Boolean  @default(false)
  isPrivate   Boolean  @default(true)
  isPrayedFor Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prayer_requests")
}

model MembershipApplication {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String
  city        String
  church      String
  roleInChurch String?
  motivation  String
  skills      String?
  status      String   @default("PENDING") // PENDING, APPROVED, CONTACTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("membership_applications")
}

model DonationIntent {
  id            String   @id @default(uuid())
  donorName     String
  donorEmail    String?
  donorPhone    String?
  amount        Float
  currency      String   @default("HTG") // HTG, USD, CAD, EUR
  channel       String   // MONCASH, NATCASH, PAYPAL, BANK_TRANSFER, BIBLE_SPONSOR, TROPHY_SPONSOR
  targetProject String   @default("GENERAL") // GENERAL, EVANGELISM, TOURNAMENTS, SOCIAL_AID, THEOLOGY
  referenceCode String?
  notes         String?
  status        String   @default("DECLARED") // DECLARED, CONFIRMED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("donation_intents")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?
  language  String   @default("fr") // fr, ht, en
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  period      String
  periodId    String?
  year        Int      @default(2025)
  category    String   // evangelisation, sport, social, theologie, finances, annuel
  author      String
  summary     String
  content     String
  metrics     Json?    // Array of { label, value }
  highlights  String[] // Key bullet points
  pdfUrl      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}

model SiteStatistic {
  id                          String   @id @default("global-stats")
  visionTarget                Int      @default(100000)
  currentReachedSouls         Int      @default(12450)
  confirmedDecisionsForChrist  Int      @default(424)
  partnerChurches             Int      @default(24)
  youthAthletesEngaged        Int      @default(1850)
  biblesDistributed           Int      @default(875)
  socialAidBeneficiaries      Int      @default(365)
  activeVolunteers            Int      @default(120)
  totalMobilizedHtg           Float    @default(1135000)
  fieldAllocationRate         Float    @default(92.4)
  quarterlyData               Json?
  localityData                Json?
  updatedAt                   DateTime @updatedAt

  @@map("site_statistics")
}


